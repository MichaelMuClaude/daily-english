# Copy to .env for local development. Never commit the real .env.

# Azure SQL (Entra-only authentication, no password)
SQL_SERVER=your-server.database.windows.net
SQL_DB=db-english

# LLM: Azure OpenAI endpoint + deployment name (Entra token auth, no API key)
AOAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AOAI_DEPLOYMENT=your-deployment

# Client ID of the user-assigned managed identity (only needed in Azure)
AZURE_CLIENT_ID=

# auth: "easyauth" (Azure Container Apps built-in authentication) or "dev"
AUTH_MODE=dev
# only used when AUTH_MODE=dev
DEV_USER=you@example.com

PORT=3000
